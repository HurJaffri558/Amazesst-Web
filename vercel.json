{
  "framework": null,
  "installCommand": "echo Static site",
  "buildCommand": "unzip -qo amazesst-production.zip && sed -i '/^.founder-photo{/s/aspect-ratio:4\\/5/aspect-ratio:auto/; /^.founder-photo .founder-portrait{/s/{.*/{display:block;width:100%;height:auto;position:relative}/' amazesst-production/index.html",
  "outputDirectory": "amazesst-production",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/Amazesst_Website_Testimonials_VSL.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/#blog",
      "permanent": true
    },
    {
      "source": "/starter",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/growth",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/scale",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/enterprise",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/case-studies/:path*",
      "destination": "/#cases",
      "permanent": true
    }
  ]
}
