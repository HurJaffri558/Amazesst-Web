{
  "framework": null,
  "installCommand": "echo Static site",
  "buildCommand": "unzip -qo amazesst-production.zip && node -e 'const fs=require(\"node:fs\"); const p=\"amazesst-production/index.html\"; fs.writeFileSync(p,fs.readFileSync(p,\"utf8\").replace(\"</head>\",\"<style>#founder .founder-photo{display:block;aspect-ratio:auto;background:#08090c}#founder .founder-portrait{position:static;display:block;width:100%;height:auto}</style></head>\"))'",
  "outputDirectory": "amazesst-production",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/Amazesst_Website_Testimonials_VSL.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/#blog",
      "permanent": true
    },
    {
      "source": "/starter",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/growth",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/scale",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/enterprise",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/case-studies/:path*",
      "destination": "/#cases",
      "permanent": true
    }
  ]
}
